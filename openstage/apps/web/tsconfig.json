{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@openstage/contracts": ["../../packages/contracts/src/index.ts"],
      "@openstage/domain": ["../../packages/domain/src/index.ts"],
      "@openstage/storage": ["../../packages/storage/src/index.ts"],
      "@openstage/context-engine": ["../../packages/context-engine/src/index.ts"],
      "@openstage/gateway": ["../../packages/gateway/src/index.ts"],
      "@openstage/inspector": ["../../packages/inspector/src/index.ts"],
      "@openstage/memory": ["../../packages/memory/src/index.ts"],
      "@openstage/agent": ["../../packages/agent/src/index.ts"],
      "@openstage/extensions": ["../../packages/extensions/src/index.ts"],
      "@openstage/recipe": ["../../packages/recipe/src/index.ts"],
      "@openstage/card-converter": ["../../packages/card-converter/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
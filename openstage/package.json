{
  "name": "openstage",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "SillyTavern 数据与交互生态的兼容迁移平台 + 面向现代模型的 Agent Runtime",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx tools/cli/src/index.ts",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke.ps1",
    "web:build": "pnpm --filter @openstage/web exec vite build"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3"
  }
}